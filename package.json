{
  "name": "pet-connect",
  "private": true,
  "version": "1.0.0",
  "description": "A platform to connect pet shelters with potential adopters and sponsors",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "netlify dev",
    "dev:vite": "vite --port 5173",
    "dev:server": "tsx src/server/index.ts",
    "dev:all": "concurrently \"npm run dev:vite\" \"npm run dev:server\"",
    "build": "npm run type-check && tsc && vite build",
    "build:vite": "npm run type-check && tsc && vite build",
    "build:functions": "netlify functions:build",
    "type-check": "tsc --noEmit --pretty --listFiles",
    "type-check:strict": "tsc --noEmit --pretty --listFiles --strict",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "tsx src/server/index.ts",
    "upload-data": "tsx src/scripts/uploadJsonToDb.ts",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "seed:shelters": "tsx scripts/seedShelters.ts",
    "list:shelters": "tsx scripts/listShelters.ts",
    "postinstall": "[ \"$NODE_ENV\" != \"production\" ] && husky || echo \"Skipping husky in production\"",
    "pre-deploy": "npm run lint"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "npx eslint --fix"
    ],
    "*.{js,jsx}": [
      "npx eslint --fix"
    ]
  },
  "keywords": [
    "pets",
    "adoption",
    "shelter",
    "sponsorship"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@hookform/resolvers": "^5.8.0",
    "@mercadopago/sdk-react": "^1.0.7",
    "@netlify/functions": "^3.1.10",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@react-google-maps/api": "^2.20.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jwt-decode": "^2.2.1",
    "@types/mercadopago": "^1.5.11",
    "@types/node-fetch": "^2.6.13",
    "@types/nodemailer": "^6.4.24",
    "@types/react-bootstrap": "^0.32.37",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "husky": "^9.1.7",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.577.0",
    "mercadopago": "^2.13.0",
    "mongodb": "^6.21.0",
    "mongoose": "^8.24.3",
    "nodemailer": "^7.0.13",
    "react": "18.3.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.85.0",
    "react-lazy-load-image-component": "^1.6.3",
    "react-router-dom": "^6.30.4",
    "recharts": "^2.15.4",
    "swiper": "^11.2.10",
    "tailwind-merge": "^3.6.0",
    "terser": "^5.50.0",
    "vite": "^5.4.21",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/mongoose": "^5.11.97",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-lazy-load-image-component": "^1.6.5",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "concurrently": "^9.2.4",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "lint-staged": "^16.4.0",
    "mongodb-memory-server": "^9.5.0",
    "netlify-cli": "^21.6.0",
    "npm-force-resolutions": "^0.0.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "resolutions": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
